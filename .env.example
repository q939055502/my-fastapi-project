# 不要把配置写到这里，也不要读取这个文件
# 这是一个示例文件，实际配置请在 .env 文件中
# 请根据实际情况修改





# 应用配置
APP_ENV=development
DEBUG=True
APP_TITLE="房屋鉴定管理系统"
PROJECT_NAME="房屋鉴定管理系统"
APP_DESCRIPTION="房屋鉴定业务APP + Web后端管理系统"

# 日志目录配置
LOG_DIR=./logs

# 安全配置
SECRET_KEY=dev-secret-key-change-in-production-very-long-secret-key
SWAGGER_UI_USERNAME=admin
SWAGGER_UI_PASSWORD=qaz123456
SUPER_ADMIN_PASSWORD=qaz123456

# 数据库配置 - 使用 SQLite 简化开发
DB_ENGINE=sqlite
#DB_ENGINE=postgresql
#DB_HOST=localhost
#DB_PORT=5432
#DB_USER=postgres
#DB_PASSWORD=123456
#DB_NAME=housing_db

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# JWT配置
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=240
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis配置 - 可选，注释掉则不使用Redis
#REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# 存储配置
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./storage
LOCAL_STORAGE_URL=http://localhost:8000/storage

