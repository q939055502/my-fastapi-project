# AI，你先不管这个，只是备份，无任何作用，后续如果需要修改我会删除此注释的。

# ========== 应用基本配置 ==========
APP_ENV=development
DEBUG=True
VERSION=1.0.0
APP_TITLE="管理系统"
PROJECT_NAME="管理系统"
APP_DESCRIPTION="业务APP + Web后端管理系统"

# ========== 日志配置 ==========
LOG_DIR=./logs
# 日志保留天数配置
LOG_ACCESS_RETENTION_DAYS=30      # 访问日志保留天数
LOG_ERROR_RETENTION_DAYS=90       # 错误日志保留天数
LOG_BUSINESS_RETENTION_DAYS=30    # 业务日志保留天数
LOG_SECURITY_RETENTION_DAYS=180   # 安全日志保留天数
LOG_AUDIT_RETENTION_DAYS=365     # 审计日志保留天数
LOG_ROTATION_SIZE=100 MB          # 日志轮转大小
LOG_COMPRESSION=zip               # 日志压缩格式

# ========== 安全配置 ==========
SECRET_KEY=dev-secret-key-change-in-production-very-long-secret-key
SWAGGER_UI_USERNAME=admin
SWAGGER_UI_PASSWORD=qaz123456
SUPER_ADMIN_PASSWORD=qaz123456

# ========== 数据库配置 ==========
# 选择数据库引擎: sqlite | mysql | postgresql
DB_ENGINE=mysql

# ========== SQLite 配置 (备用) ==========
# 不需要额外配置，自动使用项目根目录的 db.sqlite3

# ========== MySQL 配置 ==========
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=app_user
MYSQL_PASSWORD=123456
MYSQL_DATABASE=app_db

# ========== PostgreSQL 配置 ==========
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app_user
POSTGRES_PASSWORD=123456
POSTGRES_DB=app_db

# ========== Redis 配置 ==========
REDIS_URL=redis://:123456@localhost:6378/0

# ========== CORS配置 ==========
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ========== JWT配置 ==========
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=240
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== Redis配置（可选）==========
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# ========== 存储配置 ==========
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./storage
LOCAL_STORAGE_URL=http://localhost:8000/storage
